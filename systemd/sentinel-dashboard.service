[Unit]
Description=ULTRON Dashboard (Pi4 GOVERNANCE) - HTTPS on ultron.lan
Documentation=file:///opt/ultron/dashboard
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=ultron
Group=ultron
WorkingDirectory=/opt/ultron/dashboard

# ── Network ──────────────────────────────────────────────────────────────────
Environment=ULTRON_HTTP_HOST=0.0.0.0
Environment=ULTRON_HTTP_PORT=8080
Environment=ULTRON_HTTPS_PORT=443
Environment=ULTRON_MQTT_HOST=127.0.0.1
Environment=ULTRON_MQTT_PORT=1883
Environment=ULTRON_MQTT_USER=dash
# Set ULTRON_MQTT_PASS via drop-in: systemctl edit sentinel-dashboard

# ── TLS ──────────────────────────────────────────────────────────────────────
Environment=ULTRON_TLS_CERT=/opt/ultron/dashboard/certs/server.crt
Environment=ULTRON_TLS_KEY=/opt/ultron/dashboard/certs/server.key

# ── Auth (WebAuthn) ──────────────────────────────────────────────────────────
Environment=ULTRON_RP_ID=ultron.lan
Environment=ULTRON_RP_NAME=ULTRON
Environment=ULTRON_ORIGINS=https://ultron.lan
Environment=ULTRON_AUTH_DB=/var/lib/ultron/auth.db

# ── Paths ────────────────────────────────────────────────────────────────────
Environment=ULTRON_EVIDENCE_DB=/mnt/pendrive/ultron/ultron.db
Environment=ULTRON_DEBUG=0

ExecStart=/opt/ultron/dashboard/venv/bin/python -c "from server.main import main; main()"
Restart=always
RestartSec=5

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ultron
ReadOnlyPaths=/mnt/pendrive
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
